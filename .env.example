NODE_ENV=development

PORT=3000

# Opción 1: URL completa (Recomendado para Supabase / Render)
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Opción 2: Variables individuales (Desarrollo local)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lubrillantas
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false

# Si es true, carga clientes, vehículos y productos de prueba al iniciar (si la BD está vacía)
SEED_DEMO_DATA=false

CORS_ORIGIN=http://localhost:5173

JWT_SECRET=
JWT_EXPIRES_IN=8h
